# CircuitVision Backend Environment Variables
# Copy this file to .env and fill in your values

# Required: Google Gemini API key for VLM component value extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenRouter API key (alternative to Gemini)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Enable debug mode (includes traceback in error responses)
# DEBUG=1
